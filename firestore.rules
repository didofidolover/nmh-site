rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each customer can read and edit only her own profile (name, phone, measurements, address, wishlist).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Anyone can place an order (guest checkout). A signed-in customer can read only her own orders.
    // Nobody can change or delete an order from the website; the brand manages orders in the Firebase console.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'items', 'total', 'contact', 'address', 'uid'])
                    && request.resource.data.id == orderId
                    && request.resource.data.total is number
                    && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
                    && (request.resource.data.uid == null
                        || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
